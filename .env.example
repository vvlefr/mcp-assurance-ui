# Configuration OpenAI pour le chatbot
# Copier ce fichier en .env et remplir avec vos clés

# Clé API OpenAI (GPT-4o-mini recommandé pour rapidité/fiabilité)
BUILT_IN_FORGE_API_KEY=sk-your-openai-api-key-here
BUILT_IN_FORGE_API_URL=https://api.openai.com

# Configuration Digital Insure API (optionnel - déjà configuré dans le code)
# DIGITAL_INSURE_API_URL=https://catgo.multinet-inside.fr/digitalinsure-gateway-middleware
# DIGITAL_INSURE_LOGIN=your_login
# DIGITAL_INSURE_PASSWORD=your_password
